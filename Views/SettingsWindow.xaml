<Window x:Class="YetAnotherCountdownTimerNext.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YetAnotherCountdownTimerNext.Views"
        mc:Ignorable="d"
        Title="设置" Height="370" Width="420"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Gradient colors -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F0F9FF" Offset="0.0"/>
            <GradientStop Color="#E1F1FF" Offset="0.5"/>
            <GradientStop Color="#D2E9FF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Button Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#44000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4C8AE6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3070C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2060B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Box Style -->
        <Style x:Key="CustomTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F0F8FF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#A0C0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4C8AE6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Date Picker Style -->
        <Style x:Key="CustomDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="#F0F8FF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#A0C0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="CustomCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#3070C0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="checkBoxBorder" BorderBrush="#A0C0E0" BorderThickness="1" 
                                    Background="#F0F8FF" Width="18" Height="18" CornerRadius="3">
                                <Path x:Name="checkMark" Stroke="#4C8AE6" StrokeThickness="2" 
                                      Data="M 4,9 L 7,12 L 14,5" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" 
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#E1F1FF"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#4C8AE6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#4C8AE6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{StaticResource BackgroundGradient}" Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3" Color="#555555"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Grid Grid.Row="0" Height="45">
                <TextBlock Text="设置" Foreground="#3070C0" FontSize="16" FontWeight="Bold"
                         VerticalAlignment="Center" Margin="20,0,0,0"/>
                
                <Button x:Name="CloseButton" Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right" Click="CloseButton_Click">
                    <TextBlock Text="✖" FontSize="16" Foreground="#3070C0"/>
                </Button>
            </Grid>
            
            <!-- Settings Content -->
            <Border Grid.Row="1" Background="#F8FBFF" Margin="15,0,15,10" CornerRadius="8">
                <StackPanel Margin="20">
                    <!-- Countdown Title -->
                    <TextBlock Text="倒计时标题" Foreground="#3070C0" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TitleTextBox" Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,0,15"/>
                    
                    <!-- Target Date -->
                    <TextBlock Text="目标日期" Foreground="#3070C0" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DatePicker x:Name="TargetDatePicker" Style="{StaticResource CustomDatePickerStyle}" Margin="0,0,0,20"/>
                    
                    <!-- Options -->
                    <TextBlock Text="选项" Foreground="#3070C0" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="AutoStartCheckBox" Content="开机自启动" 
                              Style="{StaticResource CustomCheckBoxStyle}"/>
                    
                    <CheckBox x:Name="TopMostCheckBox" Content="窗口置顶" 
                              Style="{StaticResource CustomCheckBoxStyle}"/>
                    
                    <CheckBox x:Name="MinimizeToTrayCheckBox" Content="最小化到托盘" 
                              Style="{StaticResource CustomCheckBoxStyle}"/>
                </StackPanel>
            </Border>
            
            <!-- Button Panel -->
            <Grid Grid.Row="2" Margin="15,0,15,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="CancelButton" Content="取消" Grid.Column="0" Margin="0,0,5,0"
                      Style="{StaticResource ActionButtonStyle}" Background="#DDDDDD" Click="CancelButton_Click"/>
                
                <Button x:Name="SaveButton" Content="保存" Grid.Column="1" Margin="5,0,0,0"
                      Style="{StaticResource ActionButtonStyle}" Click="SaveButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>